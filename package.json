{
  "name": "fuego-artisan",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-db.mjs && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:setup": "prisma generate --schema prisma/schema.local.prisma && DATABASE_URL=\"file:./dev.db\" prisma db push --schema prisma/schema.local.prisma && DATABASE_URL=\"file:./dev.db\" tsx prisma/seed.ts",
    "db:setup:pg": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "gsap": "^3.12.5",
    "lenis": "^1.1.14",
    "next": "14.2.15",
    "next-pwa": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
