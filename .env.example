# ============================================================
# FUEGO ARTISAN — configuração de banco de dados
# ============================================================
# Copie este arquivo para `.env.local` (cp .env.example .env.local)
# e rode:  npm run db:setup   depois:  npm run dev

# --- Opção 1 (padrão / recomendado para rodar localmente) ---
# SQLite: zero configuração, tudo fica salvo em prisma/dev.db
DATABASE_URL="file:./dev.db"

# --- Opção 2 (produção / Vercel + Neon / Supabase Postgres) ---
# Descomente a linha abaixo e substitua pela sua connection string,
# depois rode:  npm run db:setup:pg
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
